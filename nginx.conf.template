server {
    listen       80;
    server_name  localhost;

    client_max_body_size 50M;

    # 静态文件服务
    location / {
        root   /usr/share/nginx/html;
        index  index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    # 反向代理配置 - 去掉 /dev-api/ 前缀后转发
    location /dev-api/ {
        client_max_body_size 100m;
        rewrite ^/dev-api/(.*) /$1 break;
        proxy_pass http://10.219.9.139:8004;

        add_header X-Proxy-Debug "代理目标: http://10.219.9.139:8004" always;
        add_header X-Original-URI "$request_uri" always;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 600s;
        proxy_connect_timeout 600s;
        proxy_cache off;
    }

    # 反向代理配置 - 去掉 /record-api/ 前缀后转发
    location /record-api/ {
        client_max_body_size 100m;
        rewrite ^/record-api/(.*) /$1 break;
        proxy_pass http://10.219.9.139:8004;

        add_header X-Proxy-Debug "代理目标: http://10.219.9.139:8004" always;
        add_header X-Original-URI "$request_uri" always;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 600s;
        proxy_connect_timeout 600s;
        proxy_cache off;
    }

    # 错误处理
    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        root   /usr/share/nginx/html;
    }
}